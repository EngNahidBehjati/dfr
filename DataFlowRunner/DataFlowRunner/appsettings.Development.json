{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "LogProvider": {
      "ProviderType": "Console",
      "FolderPath": ""
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "OpenTelemetry": {
    "Enabled": true,
    "OtlpEndpoint": "http://localhost:4317",
    "ServiceName": "DataFlowRunner"
  },
  "AllowedHosts": "*",
  "Development": {
    "DataFlowBuilder": {
      "BaseUrl": "http://localhost:5000"
    }
  }
}
