{
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:58095"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "LogProvider": {
      "ProviderType": "None",
      "FolderPath": ""
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "OpenTelemetry": {
    "Enabled": false,
    "OtlpEndpoint": "http://localhost:4317",
    "ServiceName": "DataFlowRunner"
  },
  "AllowedHosts": "*",
  "AppSettings": {
    "DataFlowBuilder": {
      "BaseUrl": "http://localhost:5000",
      "EngineCertHash": ""
    },
    "Kafka": {
      "BootstrapServer": "localhost:9092",
      "TopicPrefix": ""
    },
    "NodeExecutorEngine": {
      "TableQueryInvokeTimeoutInSeconds": "300",
      "RetryExecutionInvokeTimeoutInSeconds": "120"
    },
    "FeatureFlags": {
      "WaitForDataFlowVersionUpdate": true
    }
  }
}
